Student:

function Student(){

    const name = "Jan Kowalski";
    const pkt = 14;
    const godziny =2000;
    const opusz = 130;
    const frek = Math.round((godziny-opusz)/godziny*100);
    const pktProc = Math.round(pkt/20*100)
    const rezultat= frek >=90 && pktProc>=75? "Zaliczone":"Niezaliczone";
    
    const stylNiezalicz={
        color: '#ff0000',
        fontWeight:'800'
    }
    const stylZalicz={
        color: '#00ff00',
        fontWeight:'800',
    }
    return(
        <>
            <h3>{name}</h3>
            <p>Punkty: {pkt}/20</p>
            <p>Wynik: {Math.round(pkt/20*100)}%</p>
            <p>Frekwencja: {Math.round((godziny-opusz)/godziny*100)}%</p>
            <p style={frek >=90 && pktProc>=75? stylZalicz : stylNiezalicz}>Wynik końcowy: {rezultat}</p>
            <img style={{width: '400px'}} src="student.jpg" alt=""/>
        </>
    )

}
export default Student;


