function CardCourse({title,content,hours,likes}){
    
    const [likeLive, setLikeLive] = useState(likes);
    const handleLike = () =>{
        setLikeLive(prev => prev+1);    
    }
    
    return(
       <div>
            <h2> {title}</h2>
            <p>{content}</p>
            <h5>Ilość godzin: {hours} </h5>
            <div>Polubienia: {likeLive}</div>
            <button onClick={handleLike}>Dodaj Polubienie</button>
        </div>
    )
}
export default CardCourse;

