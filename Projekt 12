import { useState } from 'react';

function Form({ add }) { // Added 'add' prop since it's called in handleSubmit
    const [rower, setRower] = useState({
        name: "", 
        price: 0, 
        colour: "", 
        model: ""
    });

    const handleSubmit = (event) => {
        event.preventDefault();
        console.log(rower);
        const nowy = {
            ...rower,
            id: Date.now(),
        };
        add(nowy); // Pass the complete object with id
    };

    const handleChange = (event) => {
        setRower(prev => ({
            ...prev, 
            [event.target.name]: event.target.value
        }));
    };

    return (
        <div className="container row col-6">
            <h1>Dodaj rower</h1>
            <form onSubmit={handleSubmit}>
                <div className="form-field">
                    <label htmlFor="nazwaRoweru" className="form-label">Nazwa roweru</label>
                    <input 
                        type="text" 
                        id="nazwaRoweru" 
                        name="name" /* Changed from "nazwa" to "name" */
                        className="form-control" 
                        value={rower.name} 
                        onChange={handleChange}
                    />
                </div>

                <div className="form-field">
                    <label htmlFor="modelRoweru" className="form-label">Model roweru</label>
                    <input 
                        type="text" 
                        id="modelRoweru" 
                        name="model" 
                        value={rower.model}
                        className="form-control" 
                        onChange={handleChange}
                    />
                </div>

                <div className="form-field">
                    <label htmlFor="cenaRoweru" className="form-label">Cena roweru</label>
                    <input 
                        name="price" /* Changed from "cena" to "price" */
                        type="number" 
                        id="cenaRoweru" 
                        className="form-control"
                        value={rower.price}
                        onChange={handleChange}
                    />
                </div>

                <div className="form-field">
                    <label htmlFor="kolorRoweru" className="form-label">Kolor roweru</label>
                    <input 
                        type="text" 
                        id="kolorRoweru" 
                        className="form-control"
                        name="colour" /* Changed from "kolor" to "colour" */
                        value={rower.colour}
                        onChange={handleChange}
                    />
                </div>

                <div className="form-field">
                    <button type="submit" className="btn-solid theme-primary">Dodaj rower</button>
                </div>
            </form>
        </div>
    );
}

export default Form;

