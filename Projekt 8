CourseCard

function CourseCard({course}){
    return (
        <article>
            <div>
                <img src={course.image} alt={course.imageAlt} style={{width:"300px"}}/>
            </div>
            <div>
                <h2>
                    {course.title}
                </h2>
            
            <p>
                {course.description}
            </p>
            </div>
            <div>
                <p>Prowadzący: {course.teacher}</p>
                <p>Cena: {course.price}</p>
                <p>Długość kursu: {course.length}</p>
            </div>
            <div><button>Zapisz się!</button></div>
        </article>
    )
}
export default CourseCard;

