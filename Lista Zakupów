import { useState } from 'react'

function ProductList({ products, onDeleteProduct }) {
  return (
    <div className="container mt-4">
      <div className="row">
        <table className="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nazwa produktu</th>
              <th>Cena produktu</th>
              <th>Ilość</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {products.map((item, index) => (
              <tr key={index}>
                <td>{item.id}</td>
                <td>{item.productName}</td>
                <td>{item.productPrice}</td>
                <td>{item.productAmount}</td>
                <td>
                  <button 
                    className="btn btn-warning"
                    onClick={() => onDeleteProduct(item.id)}
                  >
                    Usuń
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )
}

function AddProductForm({ onAddProduct }) {
  const [productName, setProductName] = useState("")
  const [productPrice, setProductPrice] = useState("")
  const [productAmount, setProductAmount] = useState("")

  function HandleSubmit(e) {
    e.preventDefault() // Zatrzymuje domyślne odświeżanie strony przez formularz
    
    if (!productName || !productPrice || !productAmount) {
      return alert("Uzupełnij formularz!")
    }

    // Wywołanie funkcji przekazanej z App
    onAddProduct({
      id: Number(new Date()),
      productName: productName,
      productPrice: Number(productPrice),
      productAmount: Number(productAmount)
    });

    // Czyszczenie formularza po dodaniu
    setProductName("");
    setProductPrice("");
    setProductAmount("");
  }

  return (
    <form onSubmit={HandleSubmit}>
      <div className="mb-3">
        <label htmlFor="productName" className="form-label">Nazwa produktu</label>
        <input
          type="text"
          name="productName"
          id="productName"
          className="form-control"
          placeholder="produkt"
          value={productName}
          onChange={(e) => setProductName(e.target.value)}
        />
      </div>
      <div className="mb-3">
        <label htmlFor="productPrice" className="form-label">Cena produktu</label>
        <input
          type="number"
          name="productPrice"
          id="productPrice"
          className="form-control"
          placeholder="0"
          value={productPrice}
          onChange={(e) => setProductPrice(e.target.value)}
        />
      </div>
      <div className="mb-3">
        <label htmlFor="productAmount" className="form-label">Ilość produktu</label>
        <input
          type="number"
          name="productAmount"
          id="productAmount"
          className="form-control"
          placeholder="0"
          value={productAmount}
          onChange={(e) => setProductAmount(e.target.value)}
        />
      </div>
      <button className="btn btn-primary">Dodaj produkt</button>
    </form>
  )
}

function App() {
  const [products, setProducts] = useState([
    {
      id: 1,
      productName: "mleko",
      productPrice: 5.99,
      productAmount: 2
    },
    {
      id: 2,
      productName: "masło",
      productPrice: 5.25,
      productAmount: 3
    }
  ])

  function handleAddProduct(newProduct) {
    setProducts([...products, newProduct])
  }

  function handleDeleteProduct(id) {
    setProducts(prev => prev.filter((item) => item.id !== id))
  }


  let totalCost = 0;
  for (let i = 0; i < products.length; i++) {
    totalCost += products[i].productPrice * products[i].productAmount;
  }


  return (
    <div>
      <h2 className="text-center">Lista produktów</h2>
      <div className="container py-4">
        <div className="row">
          <div className="col-md-7">
            <ProductList products={products} onDeleteProduct={handleDeleteProduct} />
            

            <div className="mt-3">
              Razem: {totalCost.toFixed(2)} zł
            </div>
          </div>

          <div className="col-md-5">
            <AddProductForm onAddProduct={handleAddProduct} />
          </div>
        </div>
      </div>
    </div>
  )
}
export default App


