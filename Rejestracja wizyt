//console.log(visits);
  

  return (
    <div className="container mt-4">
      <div className="row">
        <div className="col-6">
          <Form onAddVisit={handleAddVisit}/>
        </div>
      </div>
      <List visits={visits}/>
    </div>
  );
}

export default App
