Produkt:

import './Produkt.css';
function Produkt(){
    
    const products = [
        {'nazwa':'Kawa', 'opis':'najlepsza kawa Sido', 'cena': 10},
        {'nazwa':'Herbata', 'opis':'najlepsza herbata ceylon', 'cena': 15},
        {'nazwa':'Mleko', 'opis':'najlepsza mleko Łaciate', 'cena': 7},
            ];  
        
    return(
        <>
            {products.map( (item,index) => (
                <div className='prod' key={index}>
                    <h2>{item.nazwa}</h2>
                    <p>Opis: {item.opis}</p>
                    <h4>Cena: {item.cena}</h4>
                </div>
            )) }
            
    </>
    )
};
export default Produkt;

